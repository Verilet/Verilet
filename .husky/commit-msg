commit_msg="$(head -n 1 "$1")"
valid_commit_regex="^(build|chore|ci|docs|feat|fix|perf|refactor|style|test|revert)(\([a-zA-Z0-9_-]+\))?: .+$"

if [[ ! $commit_msg =~ $valid_commit_regex ]] && [[ ! $commit_msg =~ ^Merge ]]; then
    echo "------------------------------------------------------"
    echo "❌ ERROR: Invalid commit message: '$commit_msg'"
    echo ""
    echo "Commit messages must follow the format: type(optional-scope): description"
    echo "Allowed types: (build, chore, ci, docs, feat, fix, perf, refactor, style, test)"
    echo ""
    echo "Examples:"
    echo "  feat(client): add url scanner form"
    echo "  ci: initialize repo scaffold and pipeline"
    echo "------------------------------------------------------"
    exit 1
fi
