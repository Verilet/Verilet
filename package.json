{
  "devDependencies": {
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"client/**/*.{ts,tsx,js,jsx}\" \"server/**/*.{ts,js}\" \"**/*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"client/**/*.{ts,tsx,js,jsx}\" \"server/**/*.{ts,js}\" \"**/*.{json,md,yml,yaml}\"",
    "lint": "npm --prefix client run lint && npm --prefix server run lint"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "server/**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
