MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
# Clerk keys from the Clerk dashboard. Or, from server/, run `npx -y clerk@latest env pull`,
# which writes them to server/.env.local (also loaded, and it wins over this file).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
