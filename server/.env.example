MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
# RENT_DB_NAME=test_dataBase

# Clerk keys from the Clerk dashboard (API keys). Or, from server/, run
# `npx -y clerk@latest env pull`, which writes them to server/.env.local (loaded first).
# Without them, /api/scans answers 503.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
